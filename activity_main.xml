<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:adjustViewBounds="true"
            android:contentDescription="Logo EDYLASER3D"
            android:scaleType="centerInside"
            android:src="@drawable/edylaser_logo" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_gravity="center_horizontal"
            android:text="Programador de placas QR + NFC"
            android:textColor="#486581"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/txtCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="Placas programadas: 0"
            android:textColor="#16A085"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#FFFFFF"
            android:gravity="center"
            android:minHeight="130dp"
            android:padding="20dp"
            android:text="1. Escanea el QR de la placa"
            android:textColor="#102A43"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="Aún no hay un QR cargado"
            android:textColor="#627D98"
            android:textIsSelectable="true"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#16A085"
            android:text="ESCANEAR QR"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D9E2EC"
            android:text="CANCELAR Y LIMPIAR"
            android:textColor="#334E68" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="Después de escanear, acerca la placa a la zona NFC del teléfono y no la retires hasta sentir la vibración."
            android:textColor="#829AB1"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
